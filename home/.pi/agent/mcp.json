{
  "mcpServers": {
    "apify-job-listings": {
      "url": "https://mcp.apify.com/?tools=fetch-actor-details,fantastic-jobs/career-site-job-listing-api",
      "headers": {
        "Authorization": "Bearer {env:APIFY_JOBS_PAT}"
      }
    },
    "dash": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ]
    },
    "github-readonly": {
      // Read-only GitHub surface: `--read-only` removes every write tool from
      // the advertised schema, even inside write-capable toolsets.
      //
      // `command` is an absolute path on purpose: pi-mcp-adapter interpolates
      // {env:VAR} in `args`/`env` but does NOT expand `~` or variables in
      // `command` (server-manager.ts resolves only `cwd`/`args`/`env`), and the
      // binary is not on PATH. Do not re-add an `sh -c` wrapper just to use
      // $HOME.
      "command": "/Users/nietaki/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--read-only",
        "--toolsets",
        "context,repos,issues,pull_requests"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_READ_ONLY_TOKEN}"
      }
    },
    "github-personal-engineering": {
      // https://github.com/settings/personal-access-tokens/new?name=github-personal-engineering&description=pi%20MCP%20issue%E2%86%92PR%20engineering%20surface%20(personal%20repos%2C%20no%20merge%2C%20no%20contents%20write)&expires_in=90&metadata=read&contents=read&issues=write&pull_requests=write&actions=write&statuses=read
      "command": "/Users/nietaki/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--toolsets",
        "context,repos,issues,pull_requests,actions,labels",
        "--exclude-tools",
        "merge_pull_request,update_pull_request_branch,create_branch,create_or_update_file,push_files,delete_file,fork_repository,create_repository,label_write"
      ],
      "approveTools": [
        //   "actions_run_trigger"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_ENGINEERING_TOKEN}"
      }
    },
    "github-notifications": {
      "command": "/Users/nietaki/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--toolsets",
        "context,notifications"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_NOTIFICATIONS_TOKEN}"
      },
      "disabled": true
    },
    "github-grep": {
      "url": "https://mcp.grep.app"
    },
    "brave-search": {
      // PARKED (migrated to pi-web-access)
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "excludeTools": [
        "brave_image_search",
        "brave_video_search"
      ],
      "disabled": true
    },
    "exa": {
      // PARKED (migrated to pi-web-access)
      "url": "https://mcp.exa.ai/mcp?api_key={env:EXA_API_KEY}",
      "disabled": true
    },
    "openzim": {
      "url": "http://beehive.internal:45091/mcp",
      "headers": {
        "Authorization": "Bearer openzim_non_secret"
      },
      "disabled": true
    },
    "trmnl-plugin": {
      "url": "https://trmnl.com/mcp?api_key={env:TRMNL_MCP_API_KEY}",
      "disabled": true
    },
    "betterwright": {
      "command": "betterwright",
      "args": [
        "mcp"
      ],
      "env": {
        "BETTERWRIGHT_PROFILE": "work"
      },
      "disabled": true
    }
  }
}
