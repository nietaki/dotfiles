{
  "mcpServers": {
    "dash": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ]
    },
    "github-readonly": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/repos/github-mcp-server/github-mcp-server\" \"$@\"",
        "--",
        "--read-only",
        "--toolsets",
        "context,repos,issues,pull_requests",
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_READ_ONLY_TOKEN}"
      }
    },
    "github-notifications": {
      // PARKED (kept for later use). Re-enable: flip "disabled" to false and
      // restart pi — pi-mcp-adapter connects on demand. Needs
      // $GITHUB_MCP_NOTIFICATIONS_TOKEN set. Not denied in the permission
      // config, but it is a write-capable GitHub surface — think before
      // parking it back in.
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/repos/github-mcp-server/github-mcp-server\" \"$@\"",
        "--",
        "--toolsets",
        "context,notifications",
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_NOTIFICATIONS_TOKEN}"
      },
      "disabled": true
    },
    "github-grep": {
      "url": "https://mcp.grep.app"
    },
    "brave-search": {
      // PARKED (migrated to pi-web-access): web search now runs through the
      // pinned npm:pi-web-access extension and its web_search tool, configured
      // in ~/.pi/agent/web-search.json (providers: exa + brave, credentials from
      // the BRAVE_API_KEY env var — same wiring as below). Re-enable: flip
      // "disabled" to false, restart pi, and remove/adjust the pi-web-access
      // package + instructions/search.md so agents stop using the extension.
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "excludeTools": ["brave_image_search", "brave_video_search"],
      "disabled": true
    },
    "exa": {
      // PARKED (migrated to pi-web-access): Exa is now one of the two allowed
      // search providers inside pi-web-access, keyed from the EXA_API_KEY env
      // var (see ~/.pi/agent/web-search.json). Re-enable: flip "disabled" to
      // false, restart pi, and retire the pi-web-access package + instructions.
      "url": "https://mcp.exa.ai/mcp?api_key={env:EXA_API_KEY}",
      "disabled": true
    },
    "openzim": {
      // PARKED: only reachable on the home LAN (beehive.internal).
      // Re-enable: flip "disabled" to false and reconnect on the LAN.
      "url": "http://beehive.internal:45091/mcp",
      "headers": {
        "Authorization": "Bearer openzim_non_secret"
      },
      "disabled": true
    },
    "trmnl-plugin": {
      // PARKED: e-ink display tools, rarely wanted interactively. Double
      // safety: also denied in pi-permission-system/config.json (mcp
      // surface). To re-enable, flip "disabled" AND remove the two deny
      // rules there, or the tools load but every call is blocked.
      "url": "https://trmnl.com/mcp?api_key={env:TRMNL_MCP_API_KEY}",
      "disabled": true
    },
    "betterwright": {
      // PARKED: BetterWright browser over MCP, pinned to the "work" profile.
      // Re-enable: flip "disabled" to false and restart pi — pi-mcp-adapter
      // connects on demand. The MCP server has no --session flag, so all pi
      // sessions using this server share the default session; parallel work
      // as the same identity will serialize on that session. For multi-session
      // scenarios, use the bash route instead:
      //   betterwright run --profile work --session <name> -c "..."
      "command": "betterwright",
      "args": ["mcp"],
      "env": {
        "BETTERWRIGHT_PROFILE": "work"
      },
      "disabled": true
    }
  }
}
