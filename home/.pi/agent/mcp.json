{
  "autoEnableCodemode": true,
  "mcpServers": {
    "apify-job-listings": {
      "url": "https://mcp.apify.com/?tools=fetch-actor-details,fantastic-jobs/career-site-job-listing-api",
      "headers": {
        "Authorization": "Bearer ${APIFY_JOBS_PAT}"
      },
      "exposure": "codemode",
      "timeout": 180
    },
    "dash": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "exposure": "codemode"
    },
    "github-readonly": {
      "command": "~/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--read-only",
        "--toolsets",
        "context,repos,issues,pull_requests"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_READ_ONLY_TOKEN}"
      },
      "exposure": "codemode"
    },
    "github-personal-engineering": {
      "command": "~/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--toolsets",
        "context,repos,issues,pull_requests,actions,labels",
        "--exclude-tools",
        "merge_pull_request,update_pull_request_branch,create_branch,create_or_update_file,push_files,delete_file,fork_repository,create_repository,label_write"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_ENGINEERING_TOKEN}"
      },
      "exposure": "codemode"
    },
    "github-notifications": {
      "command": "~/repos/github-mcp-server/github-mcp-server",
      "args": [
        "stdio",
        "--toolsets",
        "context,notifications"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_NOTIFICATIONS_TOKEN}"
      },
      "enabled": false
    },
    "github-grep": {
      "url": "https://mcp.grep.app",
      "exposure": "codemode"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "toolExposure": {
        "brave_image_search": "hidden",
        "brave_video_search": "hidden"
      },
      "enabled": false
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp?api_key=${EXA_API_KEY}",
      "enabled": false
    },
    "openzim": {
      "url": "http://beehive.internal:45091/mcp",
      "headers": {
        "Authorization": "Bearer openzim_non_secret"
      },
      "enabled": false
    },
    "trmnl-plugin": {
      "url": "https://trmnl.com/mcp?api_key=${TRMNL_MCP_API_KEY}",
      "exposure": "hidden",
      "enabled": false
    },
    "betterwright": {
      "command": "betterwright",
      "args": [
        "mcp"
      ],
      "env": {
        "BETTERWRIGHT_PROFILE": "work"
      },
      "enabled": false
    }
  }
}
