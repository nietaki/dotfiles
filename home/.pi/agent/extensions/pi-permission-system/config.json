{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  // session-yolo.ts registers this authorizer link. `/yolo` or Ctrl+Alt+Y pick
  // a per-session mode for `ask` decisions: prompt (default) / allow / deny.
  // It resolves ONLY asks — applyPermissionGate runs the chain only when the
  // rule says `ask`, so every allow/deny rule below still decides for itself.
  // Opt-in & fail-safe: if the link is ever unregistered, the ask still prompts.
  // See extensions/session-yolo.ts (path/external_directory `allow`s are capped
  // back to `defer` by the package, so those asks still prompt).
  "authorizerChain": ["session-yolo"],
  // ==========================================================================
  // SINGLE-LAYER POLICY — hard, deterministic boundaries for every tool call.
  //
  // This file is the whole permission system now. pi's `tool_call` handlers
  // can only *block* (an "allow" is silence, not a grant), so the surfaces
  // below compose as an intersection: `path`/`path_read` →
  // `external_directory`/`external_directory_read` → per-tool → `bash`,
  // most-restrictive-wins, symlink-aware.
  //
  // DECODING A DENIAL (bash): the gate classifies each path token by the
  // command's effect. Proven reads (ls, cat, head, read/grep/find tools) are
  // checked against the *_read maps; everything else (jq <file>, readlink,
  // test, unknown scripts) is checked against the bare/write maps.
  //   'external_directory_read' rule '*' → even a proven read is outside every read carve-out.
  //   'external_directory' rule '*'      → the command isn't a proven read and the path is outside cwd; read carve-outs don't apply.
  //   'path' rule '~/.pi/*'              → the command isn't a proven read on the read-only pi tree.
  // KEYS: only a leading `~` is expanded (expandHomePath). $VARS / ${TMPDIR}
  // match literally, so use absolute or `~` paths.
  //
  // Removed 2026-09: the two layers that used to sit on top of this one —
  // `@pedro_klein/pi-modes` + `pi-readonly-bash` (per-mode tool substitution,
  // `bash` → `bash_readonly`) and `@shinynito/pi-menshen` (tree-sitter command
  // classification + reviewer model). See git history for their design; the
  // predecessor to the `bash` map at the bottom is this file at commit 5643577
  // (~125 per-command allow rules, deliberately not restored).
  //
  // Consequence worth stating: there is no semantic judgment of commands left.
  // `bash` is allow-all except the denies below, and every other guard is
  // path-shaped, not intent-shaped.
  //
  // LIVE: this file is re-read at tool-call time (call-time path resolution,
  // extension-paths.ts). Edits apply on the NEXT tool call in the current
  // session, with no /reload or restart. To check a rule, run the command
  // that was denied again.
  // ==========================================================================
  "permission": {
    "*": "allow",
    "path": {
      // Source of truth for fine-grained file protection (need #3).
      // Cross-cutting: applies to read/write/edit, MCP/extension tools,
      // AND path tokens extracted from bash commands. Denying here is final
      // — no other surface's allow reopens it, except an explicit `path_read`
      // entry below. Matching is symlink-aware
      // (a symlink alias cannot evade a deny).
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc-priv": "deny",
      "~/.ssh/*": "deny",
      // The whole pi-managed tree is READ-ONLY by default (flipped from
      // `allow` 2026-09-21). Everything under here is loaded on every future
      // startup, so writing it is self-modification with a delay:
      //   extensions/*.ts   -> arbitrary code, runs at next start, ALL projects
      //   instructions/*.md -> injected into every future system prompt
      //   prompts/*.md      -> slash-command templates
      //   mcp.json          -> commands the MCP adapter spawns
      //   models.json       -> custom providers, incl. baseUrl (redirects traffic)
      //   npm/              -> what gets installed on next start
      // Costs nothing in the documented workflow: the repo is the source of
      // truth (AGENTS.md), so config edits happen at home/.pi/... realpaths
      // inside the workspace, and `homeshick link` / `pi install` / `npm` do
      // their writes as child processes, which this gate never sees. Reads are
      // restored in `path_read` below.
      "~/.pi/agent/prompts/*": "allow",
      "~/.pi/*": "deny",
      "~/obsidian/pi_knowledge/*": "allow"
    },
    "path_read": {
      // Bare `path` above is sugar: its entries expand into `path_read` +
      // `path_write` with its entries placed FIRST, so a later `path_read`
      // entry has the final say for reads whatever the key order while the
      // write denial still holds. That is how ~/.pi becomes read-only rather
      // than opaque: the agent may inspect the config, extensions, prompts and
      // the multi-MB transcript history it is governed by, and may never rewrite any
      // of it. Verified by test: transcript + settings reads work, `touch
      // ~/.pi/agent/sessions/x` and `touch ~/.pi/agent/extensions/x.ts` are
      // denied.
      "~/.pi/*": "allow",
      "~/.local/share/mise/*": "allow",
      // The one path denied in BOTH directions: provider API keys. A read
      // allow would hand the keys to any tool call naming the file — and now
      // that transcripts are readable, "quote the secret into the next
      // request" is one step instead of several. Must stay AFTER the broad
      // allow above (last match wins).
      "~/.pi/agent/auth.json": "deny"
    },
    "external_directory_read": {
      // Read-only carve-out for the user's project tree: `read`/`grep`/`find`/
      // `ls` and path tokens in bash may reach into ~/repos/**, while writes
      // there stay hard-denied by the inherited `external_directory`
      // `"*": "deny"` (the bare key's entries expand FIRST, so this
      // directional map has the final say for reads only). `~/repos` matches
      // the directory entry itself (`ls ~/repos`); `~/repos/*` is greedy and
      // crosses subdirectory boundaries. No parallel `path_read` grant is
      // needed — the boundary gate is what blocked it, and a `path` allow
      // cannot loosen it. Hard `path` denies (*.env, ~/.ssh/*) still apply
      // inside this tree.
      "~/repos": "allow",
      "~/repos/*": "allow",
      // Go module cache ($GOMODCACHE, verified `go env GOMODCACHE` =
      // ~/go/pkg/mod): third-party sources are read for type/import/docs
      // lookups and `grep`/`find` sweeps. The bare entry covers the
      // directory itself (`ls ~/go/pkg/mod`); `*` is greedy so every
      // versioned submodule tree under it is covered. Module caches are
      // deliberately read-only — a write here would corrupt the
      // content-addressed sources, so it stays denied by
      // `external_directory`.
      "~/go/pkg/mod": "allow",
      "~/go/pkg/mod/*": "allow",
      // pi's own config tree, reachable for reads only (paired with the
      // `path`/`path_read` pair above, which denies writes fine-grained). The
      // bare entry covers the directory itself (`ls ~/.pi/agent`); `*` is
      // greedy, so nested transcripts and extension sources are readable
      // without any write reach. auth.json is excluded by the `path_read`
      // deny, which composes as the stricter answer.
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      // homeshick-linked user scripts (hslink, hsunlink, pi-sessions, ...).
      // What this DOES fix (source-verified 2026-09-23,
      // handlers/gates/external-directory-policy.ts): proven-read tokens —
      // `ls ~/bin`, `cat ~/bin/hslink`, read/grep/`find` over the scripts —
      // are selected onto this read surface by their effect, so debugging
      // what a bare-name command actually runs works from any cwd.
      // What it does NOT fix: full-path INVOCATION (`~/bin/x args`). Unknown
      // commands are unproven-effect, so their path tokens go to the bare
      // `external_directory` family ("*": deny) and only a write-map allow
      // would open that — deliberately not done: ~/bin/* are symlinks into
      // the dotfiles repo and script writes belong there via git. Invoke
      // these scripts by bare name (PATH lookup; the command token is not a
      // path and is never inspected).
      "~/bin": "allow",
      "~/bin/*": "allow"
    },
    "external_directory": {
      // CWD-boundary gate (need #3 continued): reaching outside the
      // working tree is denied except the temp dirs. This also governs
      // bash commands — e.g. `cat ~/notes.md` stays denied although the
      // `bash` map at the bottom happily allows `cat`.
      "*": "deny",
      // NOTE: ~/.pi is deliberately absent here. It used to be allowed in
      // both directions; writes are now blocked at the boundary (see
      // `external_directory_read`) *and* by the fine-grained `path` deny, so
      // the tree is read-only from every direction rather than relying on one
      // layer remembering the other.
      // Skills tree (auto-discovered by pi from ~/.agents/skills — the
      // harness-neutral Agent Skills location): SKILL.md files load via
      // `read` (the default-allow `path` surface), but bash must reach this
      // tree to run scripts that skills reference.
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow",
      // Mirror of the `path` allow for the mise install tree, so bash reads
      // match what read/grep can already see (pi docs/examples live under
      // .../installs/node/<ver>/lib/node_modules/@earendil-works/pi-coding-agent/).
      "~/.local/share/mise": "allow",
      "~/.local/share/mise/*": "allow",
      // BetterWright state dir ($BETTERWRIGHT_HOME) — screenshot/video
      // artifacts, browser profiles with cookies, the encrypted vault, the
      // managed BetterChromium tree, config.json, daemon sockets. Opened as a
      // whole per user decision (2026-09): the pi `browser` tool already
      // attaches its own screenshots, so gating this tree blocked only
      // path-based debugging of artifacts and the profile lock, never browser
      // operation itself.
      // NOTE: this does expose vault.enc / master-key.json / profiles to
      // path-aware tools. The "never reveal stored secrets" rule in the
      // browser skill stays behavioural for this tree, not policy-enforced.
      "~/.betterwright": "allow",
      "~/.betterwright/*": "allow",
      // The bun-installed betterwright CLI: the shim dir (run it, see what is
      // installed) and the package tree (docs/source/version debugging).
      // Deliberately NOT all of global node_modules — other globally installed
      // packages stay behind the CWD boundary.
      "~/.bun/bin": "allow",
      "~/.bun/bin/*": "allow",
      "~/.bun/install/global/node_modules/betterwright": "allow",
      "~/.bun/install/global/node_modules/betterwright/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      // Pi's knowledge vault (learnings per repo): read/write from any
      // session's cwd. Both entries are required, same shape as ~/repos: the
      // bare one covers the directory entry itself (`ls ~/obsidian/pi_knowledge`
      // or `cd` without a subpath — denied by rule '*' before this was added),
      // the greedy `*` covers everything nested under it. The matching `path`
      // allow above is redundant against `"*": "allow"` but documents intent.
      "~/obsidian/pi_knowledge": "allow",
      "~/obsidian/pi_knowledge/*": "allow",
      // pi-subagents' own temp trees: async run dirs (status.json, events.jsonl,
      // per-child output logs) under $TMPDIR/pi-subagents-uid-<uid>/async-subagent-runs/
      // and workflow artifacts under $TMPDIR/pi-subagents-<scope>/chain-runs/.
      // Needed to debug subagent runs (validation errors, child transcripts) from
      // any cwd. Scoped to `pi-subagents-*` rather than the whole per-user temp
      // tree so other apps' temp data (sockets, browser profiles, caches) stays
      // behind the boundary.
      //
      // Two spellings because on macOS $TMPDIR is /var/folders/<..>/T/ and the
      // gate resolves symlinks (/var -> /private/var) — same reason /tmp and
      // /private/tmp are both listed above. The middle segments are
      // machine-specific, so they stay wildcards (this file is portable dotfiles).
      // `*` compiles to a greedy `.*` (crosses `/`), verified in
      // wildcard-matcher.ts, so one wildcard covers the uid/hash/run-id levels.
      //
      // NOTE: the previous `"${TMPDIR}/*"` entry was REMOVED 2026-09-23 — the
      // matcher only expands `~` (expandHomePath); there is no env-var
      // expansion, so that rule matched a literal directory named `${TMPDIR}`
      // and never applied.
      "/var/folders/*/pi-subagents-*": "allow",
      "/private/var/folders/*/pi-subagents-*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "mcp": {
      // MCP servers are processes with their own file/network reach, so they
      // are gated here (the `bash` map never sees MCP tool invocations).
      "*": "allow",
      "trmnl-plugin": "deny",
      "trmnl:*": "deny"
    },
    "bash": {
      // The entire command-level policy: allow everything, deny two.
      // Trailing-` *` patterns are optional-suffix in the matcher, so bare
      // `git push` / `git reset` are covered too (verified in the source).
      //
      // With the reviewer-model layer gone this is not a backstop, it IS the
      // gate — and it is intentionally permissive rather than a maintained
      // allowlist. Everything else is bounded by path/external_directory
      // above, which catches *where* a command writes, not *what* it is.
      "*": "allow",
      "git push *": "deny",
      "git reset *": "deny"
    }
  }
}
