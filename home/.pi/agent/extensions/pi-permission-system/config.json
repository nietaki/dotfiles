{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  // ==========================================================================
  // LAYER 3/3 of the permission stack — hard, deterministic policy boundaries.
  //
  // Architecture (see ../README.md for the full reasoning):
  //   pi-modes            → which tools EXIST per mode (bash vs bash_readonly)
  //   pi-menshen          → is this command SAFE? (tree-sitter classification
  //                        + read-only registry + reviewer model) — owns the
  //                        former 150-line bash whitelist, now deleted
  //   THIS FILE (gotgenes)→ may ANYTHING touch this path/tool AT ALL? —
  //                        cross-cutting denies that no other layer's "allow"
  //                        can override (pi's tool_call handlers can only
  //                        block, so gates compose as an intersection)
  //
  // The old bash whitelist is recoverable from git history (this file at HEAD
  // before the prototype change).
  // ==========================================================================
  "shellTools": {
    // pi-modes replaces `bash` with `bash_readonly` in Ask/Brainstorm/Plan
    // modes. Without this alias the permission system would treat it as a
    // generic extension tool and the path/external_directory gates below
    // would NOT fire on paths inside its commands — i.e. `bash_readonly
    // cat ~/.ssh/id_rsa` could slip past despite the path deny.
    // This mapping gives it full bash parity: command decomposition,
    // wrapper flooring, path/external token gates, and `bash:` rules.
    "bash_readonly": {
      "commandArgument": "command"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      // Source of truth for fine-grained file protection (need #3).
      // Cross-cutting: applies to read/write/edit, MCP/extension tools,
      // AND path tokens extracted from bash commands — including the
      // aliased bash_readonly above. Menshen auto-allowing a command does
      // not open these; deny is the most-restrictive layer. Matching is
      // symlink-aware (a symlink alias cannot evade a deny).
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc-priv": "deny",
      "~/.ssh/*": "deny",
      "~/.pi/*": "allow",
      // Anti self-modification: the credential store and the permission
      // stack's own state must never be reachable through a tool call.
      // auth.json holds provider API keys (pi reads it with process fs,
      // which is not gated; only agent tool calls are). sessions/ holds
      // every past transcript. The dotfiles repo copy of the policy files
      // is edited through this workspace anyway (AGENTS.md), so denying
      // the ~/.pi-side paths costs nothing in managed sessions and stops
      // the agent rewriting its own gates in any other project.
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/sessions/*": "deny",
      "~/.pi/pi-menshen.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/config.json": "deny",
      "~/.pi/agent/settings.json": "deny",
      "~/.local/share/mise/*": "allow"
    },
    "path_read": {
      // Read-only carve-out for pi's own config. Bare `path` above is sugar
      // that expands into `path_read` + `path_write` with its entries placed
      // FIRST, so this explicit read allow has the final say for reads whatever
      // the key order, while the ANTI SELF-MODIFICATION write deny still
      // holds: the agent may inspect the package list / mode settings it is
      // governed by, and may never rewrite them.
      "~/.pi/agent/settings.json": "allow"
    },
    "external_directory": {
      // CWD-boundary gate (need #3 continued): reaching outside the
      // working tree is denied except the temp dirs. This also governs
      // bash commands — e.g. `cat ~/notes.md` stays denied even if
      // menshen's registry happily classifies `cat` as read-only.
      "*": "deny",
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      // Skills tree (auto-discovered by pi from ~/.agents/skills — the
      // harness-neutral Agent Skills location): SKILL.md files load via
      // `read` (the default-allow `path` surface), but bash must reach this
      // tree to run scripts that skills reference.
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow",
      // Mirror of the `path` allow for the mise install tree, so bash reads
      // match what read/grep can already see (pi docs/examples live under
      // .../installs/node/<ver>/lib/node_modules/@earendil-works/pi-coding-agent/).
      "~/.local/share/mise": "allow",
      "~/.local/share/mise/*": "allow",
      // BetterWright state dir ($BETTERWRIGHT_HOME) — screenshot/video
      // artifacts, browser profiles with cookies, the encrypted vault, the
      // managed BetterChromium tree, config.json, daemon sockets. Opened as a
      // whole per user decision (2026-09): the pi `browser` tool already
      // attaches its own screenshots, so gating this tree blocked only
      // path-based debugging of artifacts and the profile lock, never browser
      // operation itself.
      // NOTE: this does expose vault.enc / master-key.json / profiles to
      // path-aware tools. The "never reveal stored secrets" rule in the
      // browser skill stays behavioural for this tree, not policy-enforced.
      "~/.betterwright": "allow",
      "~/.betterwright/*": "allow",
      // The bun-installed betterwright CLI: the shim dir (run it, see what is
      // installed) and the package tree (docs/source/version debugging).
      // Deliberately NOT all of global node_modules — other globally installed
      // packages stay behind the CWD boundary.
      "~/.bun/bin": "allow",
      "~/.bun/bin/*": "allow",
      "~/.bun/install/global/node_modules/betterwright": "allow",
      "~/.bun/install/global/node_modules/betterwright/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "${TMPDIR}/*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "mcp": {
      // MCP servers are processes with their own file/network reach;
      // gating here (not in menshen, which only sees the mcp tool names).
      "*": "allow",
      "trmnl-plugin": "deny",
      "trmnl:*": "deny"
    },
    "bash": {
      // The command-by-command whitelist lived here — it is GONE.
      // Semantic judgment moved to ~/.pi/pi-menshen.json: tree-sitter
      // AST classification (read-only fast-path / write-review /
      // dangerous-deny) + a reviewer model for the long tail.
      //
      // We keep only a minimal deterministic backstop here, so the two
      // hard policy decisions from the old whitelist hold even if
      // menshen is disabled, broken, or its reviewer model misjudges.
      // A gotgenes `deny` blocks silently in every case; menshen can
      // never allow past it.
      "*": "allow",
      "git push *": "deny",
      "git reset *": "deny"
    }
  }
}
