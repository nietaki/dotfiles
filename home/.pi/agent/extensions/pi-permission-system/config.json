{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc-priv": "deny",
      "~/.ssh/*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "${TMPDIR}/*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "mcp": {
      "*": "allow",
      "trmnl-plugin": "deny",
      "trmnl:*": "deny"
    },
    "bash": {
      "*": "deny",
      "base64 *": "allow",
      "cat *": "allow",
      "cksum *": "allow",
      "cd *": "allow",
      "cp *": "allow",
      "curl *": "allow",
      "docker *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "head *": "allow",
      "git add *": "allow",
      "git check-ignore *": "allow",
      "git commit *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git push *": "deny",
      "git reset *": "deny",
      "git show *": "allow",
      "git status *": "allow",
      "go *": "allow",
      "go doc *": "allow",
      "go version *": "allow",
      "gopls *": "allow",
      "goimports *": "allow",
      "grep *": "allow",
      "helm *": "allow",
      "helm lint *": "allow",
      "jq *": "allow",
      "kubectl *": "ask",
      "ls *": "allow",
      "make": "allow",
      "make coverage *": "allow",
      "make *": "allow",
      "mix *": "allow",
      "mkdir *": "allow",
      "pdftotext *": "allow",
      "printf *": "allow",
      "qlmanage *": "allow",
      "rg *": "allow",
      "rm *.go": "allow",
      "rm /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm -rf /tmp/*": "allow",
      "rm /private/tmp/*": "allow",
      "rm -f /private/tmp/*": "allow",
      "rm -rf /private/tmp/*": "allow",
      "rsvg-convert *": "allow",
      "sed *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "staticcheck *": "allow",
      "tail *": "allow",
      "tar *": "allow",
      "touch *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "basename *": "allow",
      "column *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dig *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "exiftool *": "allow",
      "fd *": "allow",
      "ffprobe *": "allow",
      "file *": "allow",
      "groups *": "allow",
      "gsha256sum *": "allow",
      "hexdump *": "allow",
      "host *": "allow",
      "id *": "allow",
      "md5 *": "allow",
      "mdfind *": "allow",
      "mdls *": "allow",
      "netstat *": "allow",
      "od *": "allow",
      "paste *": "allow",
      "pgrep *": "allow",
      "ping *": "allow",
      "ps *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "shasum *": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "sw_vers *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "uname *": "allow",
      "uptime *": "allow",
      "whoami *": "allow",
      "xxd *": "allow"
    }
  }
}
