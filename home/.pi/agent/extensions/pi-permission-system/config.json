{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  // ==========================================================================
  // LAYER 3/3 of the permission stack — hard, deterministic policy boundaries.
  //
  // Architecture (see ../README.md for the full reasoning):
  //   pi-modes            → which tools EXIST per mode (bash vs bash_readonly)
  //   pi-menshen          → is this command SAFE? (tree-sitter classification
  //                        + read-only registry + reviewer model) — owns the
  //                        former 150-line bash whitelist, now deleted
  //   THIS FILE (gotgenes)→ may ANYTHING touch this path/tool AT ALL? —
  //                        cross-cutting denies that no other layer's "allow"
  //                        can override (pi's tool_call handlers can only
  //                        block, so gates compose as an intersection)
  //
  // The old bash whitelist is recoverable from git history (this file at HEAD
  // before the prototype change).
  // ==========================================================================
  "shellTools": {
    // pi-modes replaces `bash` with `bash_readonly` in Ask/Brainstorm/Plan
    // modes. Without this alias the permission system would treat it as a
    // generic extension tool and the path/external_directory gates below
    // would NOT fire on paths inside its commands — i.e. `bash_readonly
    // cat ~/.ssh/id_rsa` could slip past despite the path deny.
    // This mapping gives it full bash parity: command decomposition,
    // wrapper flooring, path/external token gates, and `bash:` rules.
    "bash_readonly": {
      "commandArgument": "command"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      // Source of truth for fine-grained file protection (need #3).
      // Cross-cutting: applies to read/write/edit, MCP/extension tools,
      // AND path tokens extracted from bash commands — including the
      // aliased bash_readonly above. Menshen auto-allowing a command does
      // not open these; deny is the most-restrictive layer. Matching is
      // symlink-aware (a symlink alias cannot evade a deny).
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc-priv": "deny",
      "~/.ssh/*": "deny",
      "~/.pi/*": "allow",
      "~/.local/share/mise/*": "allow"
    },
    "external_directory": {
      // CWD-boundary gate (need #3 continued): reaching outside the
      // working tree is denied except the temp dirs. This also governs
      // bash commands — e.g. `cat ~/notes.md` stays denied even if
      // menshen's registry happily classifies `cat` as read-only.
      "*": "deny",
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "${TMPDIR}/*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "mcp": {
      // MCP servers are processes with their own file/network reach;
      // gating here (not in menshen, which only sees the mcp tool names).
      "*": "allow",
      "trmnl-plugin": "deny",
      "trmnl:*": "deny"
    },
    "bash": {
      // The command-by-command whitelist lived here — it is GONE.
      // Semantic judgment moved to ~/.pi/pi-menshen.json: tree-sitter
      // AST classification (read-only fast-path / write-review /
      // dangerous-deny) + a reviewer model for the long tail.
      //
      // We keep only a minimal deterministic backstop here, so the two
      // hard policy decisions from the old whitelist hold even if
      // menshen is disabled, broken, or its reviewer model misjudges.
      // A gotgenes `deny` blocks silently in every case; menshen can
      // never allow past it.
      "*": "allow",
      "git push *": "deny",
      "git reset *": "deny"
    }
  }
}
