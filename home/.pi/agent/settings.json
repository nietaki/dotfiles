{
  "lastChangelogVersion": "0.87.0",
  "theme": "dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "qwen3.8-flash",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@gotgenes/pi-permission-system@31.1.3",
    "npm:pi-mcp-adapter@2.33.0",
    "npm:@narumitw/pi-lsp@0.49.7",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@henryqw/pi-footer@1.1.1",
    "npm:betterwright",
    "npm:pi-subagents"
  ],
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "openrouter/anthropic/claude-opus-5",
        "openrouter/openai/gpt-5.6-sol",
        "openrouter/google/gemini-3.1-pro-preview",
        "opencode-go/qwen3.7-plus",
        "opencode-go/qwen3.8-flash"
      ],
      "agents": {
        "reviewer": { "allow": ["openrouter/anthropic/claude-opus-5"] },
        "oracle": { "allow": ["openrouter/anthropic/claude-opus-5"] },
        "evidence-auditor": { "allow": ["openrouter/openai/gpt-5.6-sol"] },
        "researcher": { "allow": ["openrouter/google/gemini-3.1-pro-preview"] },
        "scout": { "allow": ["opencode-go/qwen3.7-plus"] },
        "doc-drift-sentinel": { "allow": ["opencode-go/qwen3.7-plus"] },
        "worker": { "allow": ["opencode-go/qwen3.8-flash"] },
        "delegate": { "allow": ["opencode-go/qwen3.8-flash"] }
      }
    },
    "agentOverrides": {
      "reviewer": {
        "model": "openrouter/anthropic/claude-opus-5"
      },
      "oracle": {
        "model": "openrouter/anthropic/claude-opus-5"
      },
      "evidence-auditor": {
        "model": "openrouter/openai/gpt-5.6-sol"
      },
      "researcher": {
        "model": "openrouter/google/gemini-3.1-pro-preview"
      },
      "scout": {
        "model": "opencode-go/qwen3.7-plus"
      },
      "worker": {
        "model": "opencode-go/qwen3.8-flash"
      },
      "delegate": {
        "model": "opencode-go/qwen3.8-flash"
      },
      "doc-drift-sentinel": {
        "model": "opencode-go/qwen3.7-plus"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  }
