{
  "lastChangelogVersion": "0.99.2",
  "theme": "dark",
  "defaultProvider": "openrouter",
  "defaultModel": "openai/gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:@gotgenes/pi-permission-system@31.1.3",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-lsp@0.49.7",
    "npm:betterwright",
    "npm:pi-context-view",
    "npm:pi-powerline-footer",
    "npm:pi-prompt-template-model",
    "npm:pi-subagents",
    "npm:pi-subagents-workflows@0.2.1",
    "npm:pi-web-access@0.31.0"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": false,
    "customItems": [
      {
        "id": "token-rate",
        "position": "right",
        "color": "muted"
      },
      {
        "id": "session-yolo",
        "position": "right",
        "prefix": "session-yolo",
        "color": "accent"
      }
    ],
    "model": {
      "display": "qualified"
    },
    "cache_read": {
      "format": "both"
    }
  },
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "opencode-go/qwen3.8-flash",
        "opencode-go/deepseek-v4.1-flash",
        "opencode-go/glm-5.3-flash",
        "openrouter/openai/gpt-6-luna",
        "openrouter/openai/gpt-5.6-luna-pro",
        "openrouter/openai/gpt-5.6-sol",
        "vllm-local/qwen3.8-27b"
      ],
      "agents": {
        "reviewer": {
          "allow": [
            "openrouter/openai/gpt-5.6-luna-pro",
            "opencode-go/qwen3.8-flash"
          ]
        },
        "custom-reviewer": {
          "allow": [
            "openrouter/openai/gpt-5.6-luna-pro",
            "openrouter/openai/gpt-6-luna"
          ]
        },
        "oracle": {
          "allow": [
            "openrouter/openai/gpt-5.6-sol",
            "openrouter/openai/gpt-5.6-luna-pro"
          ]
        },
        "evidence-auditor": {
          "allow": [
            "openrouter/openai/gpt-5.6-sol",
            "openrouter/openai/gpt-5.6-luna-pro"
          ]
        },
        "researcher": {
          "allow": [
            "opencode-go/deepseek-v4.1-flash",
            "openrouter/openai/gpt-5.6-luna-pro"
          ]
        },
        "scout": {
          "allow": [
            "opencode-go/deepseek-v4.1-flash",
            "opencode-go/glm-5.3-flash"
          ]
        },
        "doc-drift-sentinel": {
          "allow": [
            "opencode-go/qwen3.8-flash",
            "opencode-go/glm-5.3-flash"
          ]
        },
        "worker": {
          "allow": [
            "opencode-go/qwen3.8-flash",
            "openrouter/openai/gpt-6-luna"
          ]
        },
        "delegate": {
          "allow": [
            "opencode-go/qwen3.8-flash",
            "opencode-go/deepseek-v4.1-flash"
          ]
        },
        "verifier": {
          "allow": [
            "opencode-go/qwen3.8-flash",
            "openrouter/openai/gpt-5.6-luna-pro"
          ]
        },
        "retro-scout": {
          "allow": [
            "opencode-go/deepseek-v4.1-flash",
            "opencode-go/qwen3.8-flash"
          ]
        },
        "retro-judge": {
          "allow": [
            "openrouter/openai/gpt-5.6-sol",
            "openrouter/openai/gpt-5.6-luna-pro"
          ]
        }
      }
    },
    "agentOverrides": {
      "reviewer": {
        "model": "openrouter/openai/gpt-5.6-luna-pro"
      },
      "oracle": {
        "model": "openrouter/openai/gpt-5.6-sol"
      },
      "evidence-auditor": {
        "model": "openrouter/openai/gpt-5.6-sol"
      },
      "researcher": {
        "model": "opencode-go/deepseek-v4.1-flash"
      },
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash"
      },
      "worker": {
        "model": "opencode-go/qwen3.8-flash"
      },
      "delegate": {
        "model": "opencode-go/qwen3.8-flash"
      },
      "doc-drift-sentinel": {
        "model": "opencode-go/qwen3.8-flash"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "enabledModels": [
    "opencode-go/qwen3.8-flash",
    "opencode-go/glm-5.3-flash",
    "opencode-go/deepseek-v4.1-flash",
    "openrouter/openai/gpt-6-luna",
    "openrouter/openai/gpt-5.6-luna",
    "openrouter/openai/gpt-5.6-luna-pro",
    "openrouter/openai/gpt-5.6-sol"
  ]
}