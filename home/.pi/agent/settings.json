            "openrouter/google/gemini-3.1-pro-preview"
          ]
        },
        "scout": {
          "allow": [
            "opencode-go/qwen3.7-plus"
          ]
        },
        "doc-drift-sentinel": {
          "allow": [
            "opencode-go/qwen3.7-plus"
          ]
