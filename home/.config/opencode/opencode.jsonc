{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/instructions/*.md"
  ],
  // "model": "ollama/glm-4.7-flash-q4_K_M-24b-84k",
  // "model": "openrouter/anthropic/claude-sonnet-4.6",
  "compaction": {
    "auto": true,
  },
  "model": "opencode-go/qwen3.7-plus",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": true,
  // universal defaults
  "permission": {
    "read": "allow",
    "edit": "ask",
    "external_directory": {
      "*": "deny",
    },
    "bash": {
      "*": "deny",
      "cat *": "allow",
      "cp *": "allow",
      "docker *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "head *": "allow",
      "git add *": "allow",
      "git check-ignore *": "allow",
      "git commit *": "deny",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git push *": "deny",
      "git reset *": "deny",
      "git show *": "allow",
      "git status *": "allow",
      "go *": "allow",
      "go doc *": "allow",
      "go version *": "allow",
      "gopls *": "allow",
      "goimports *": "allow",
      "grep *": "allow",
      "helm *": "allow",
      "helm lint *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "make": "allow",
      "make coverage *": "allow",
      "make *": "allow",
      "mix *": "allow",
      "mkdir *": "allow",
      "rg *": "allow",
      "rm *.go": "allow",
      "sed *": "allow",
      "staticcheck *": "allow",
      "tail *": "allow",
      "tar *": "allow",
      "which *": "allow"
    },
    "webfetch": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    // This tool is only available when OPENCODE_EXPERIMENTAL_LSP_TOOL=true (or OPENCODE_EXPERIMENTAL=true).
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    // This tool is only available when using the OpenCode provider or when the OPENCODE_ENABLE_EXA environment variable is set to any truthy value (e.g., true or 1).
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "dash": "allow",
    "trmnl-plugin": "deny",
    "github-readonly": "allow",
    "github-notifications": "allow",
  },
  "agent": {
    "plan": {
      "model": "opencode-go/qwen3.7-plus",
      "color": "info",
      // https://opencode.ai/docs/agents/#permissions
      "permission": {
        "edit": "deny",
        "task": {
          // Control which subagents an agent can invoke via the Task tool with permission.task. Uses glob patterns for flexible matching.
          "*": "allow",
          // "orchestrator-*": "allow",
          // "code-reviewer": "ask"
        },
        "lsp": "allow",
        "skill": "allow", // TODO fix this
        "doom_loop": "allow",
      }
    },
    "build": {
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "edit": "allow",
        "bash": {
          "mkdir *": "allow",
          "git commit *": "allow",
        },
      }
    },
    "quickfix": {
      "model": "opencode-go/qwen3.7-plus",
      "color": "success",
      "description": "Small, focused changes, without iterative feedback. Filling in the gaps in a section of code.",
      "prompt": "{file:./prompts/quickfix.txt}",
      //"steps": 5,
      // "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "websearch": "deny",
        "codesearch": "allow",
        "question": "deny",
        "dash": "deny",
        "github-*": "deny",
      }
    }
  },
  "provider": {
    "llama.cpp.local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://192.168.1.37:8666/v1",
        "setCacheKey": true
      },
      "models": {
        "qwen-heavier": {
          "name": "qwen-heavier",
          "limit": {
            "context": 114000,
            "output": 32000
          },
          "options": {
            "thinking": {
              "type": "enabled",
            },
          }
        }
      }
    },
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "mdnsDomain": "opencode.local",
    // (other) allowed opencode origins
    "cors": [
      // "http://localhost:5173"
    ]
  },
  "mcp": {
    "dash": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ],
      "enabled": true
    },
    "github-readonly": {
      "type": "local",
      "command": [
        "{env:HOME}/repos/github-mcp-server/github-mcp-server",
        "--read-only",
        "--toolsets",
        // "code_security,dependabot,discussions,issues,labels,orgs,projects,pull_requests,repos,security_advisories,stargazers,users",
        "default,discussions,stargazers,labels",
        "stdio",
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_READ_ONLY_TOKEN}"
      },
      "enabled": true
    },
    "github-notifications": {
      "type": "local",
      "command": [
        "{env:HOME}/repos/github-mcp-server/github-mcp-server",
        "--toolsets",
        // "code_security,dependabot,discussions,issues,labels,orgs,projects,pull_requests,repos,security_advisories,stargazers,users",
        "context,notifications",
        "stdio",
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_NOTIFICATIONS_TOKEN}"
      },
      "enabled": false
    },
    "github-grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "openzim": {
      "type": "remote",
      "url": "http://beehive.internal:45091/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer openzim_non_secret"
      }
    },
    "trmnl-plugin": {
      "type": "remote",
      "enabled": true,
      "url": "https://trmnl.com/mcp?api_key={env:TRMNL_MCP_API_KEY}"
    }
  }
}
