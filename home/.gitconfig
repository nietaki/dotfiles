[user]
  name = Jacek Królikowski
  email = nietaki@gmail.com
  useconfigonly = true
[core]
  excludesfile = ~/.gitignore_global
[alias]
  branch-name = rev-parse --abbrev-ref HEAD
  tug = !git pull origin $(git branch-name)
  st = status
  br = branch
  co = checkout
  # Create a sibling worktree and a new branch from the current HEAD.
  # For example, `git wt-new issue 42 add telemetry` creates the branch
  # `issue-42-add-telemetry` in `<repo>-issue-42-add-telemetry`.
  # Arguments are joined with hyphens; slashes are rejected to keep the
  # worktree in a single sibling directory. Existing branches are not reset.
  wt-new = "!f() { if [ \"$#\" -eq 0 ]; then echo \"usage: git wt-new <name> [name parts...]\" >&2; return 2; fi; slug=\"$1\"; shift; for part in \"$@\"; do slug=\"$slug-$part\"; done; case \"$slug\" in */*) echo \"git wt-new: '/' is not allowed in the generated name: $slug\" >&2; return 2;; esac; git check-ref-format --branch \"$slug\" >/dev/null || return 2; root=$(git rev-parse --show-toplevel) || return; git worktree add -b \"$slug\" \"$root-$slug\" HEAD; }; f"
  # Show the branch and working-tree status of every associated worktree.
  wt-status = "!f() { git worktree list --porcelain | while IFS= read -r line; do case \"$line\" in \"worktree \"*) path=${line#worktree }; printf '\\n==> %s\\n' \"$path\"; git -C \"$path\" status --short --branch;; esac; done; }; f"
  nuke = reset --hard HEAD
  amend = commit -a --amend
  ca = commit -a
  push-simple = push -u origin HEAD
  shove = push -u origin HEAD
  force-fb = push -f origin HEAD:feature-branch
  delete-merged-branches = ! git branch --merged master | grep -v \"\\* master\" | xargs -n 1 git branch -d
  ego = summary --line
  visual = log --oneline --decorate --graph --all
  recents = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
  recent = ! git reflog | grep checkout | cut -d ' ' -f 8 | awk '!x[$0]++' | head -n 15 | nl
  co-recent = "! git reflog | grep checkout | cut -d ' ' -f 8 | awk '!x[$0]++' | head -n 15 | sed -n -e \"$1p\" | xargs git checkout #" 
  empty = commit --allow-empty -m \"empty commit\"
  reconsider = reset --soft HEAD~1
	changed = "!{ git --no-pager diff HEAD --name-only; git ls-files --others --exclude-standard; } | sort -u"
[difftool "sourcetree"]
  cmd = opendiff \"$LOCAL\" \"$REMOTE\"
  path = 
[mergetool "sourcetree"]
  cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
  trustExitCode = true
[push]
  default = simple
[init]
	defaultBranch = master
